# Required for local development AND production
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
CRON_SECRET=generate-a-long-random-string
ADMIN_AUTH_SECRET=generate-a-long-random-string-min-32-chars
AGE_GATE_SECRET=generate-a-long-random-string-min-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=set-a-strong-password-here
SITE_NAME=AfterDark Index
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Age assurance: "self_declaration" (dev only) or "external" (production).
# Unset/unknown values fail closed in production.
AGE_ASSURANCE_MODE=self_declaration

# Required only when AGE_ASSURANCE_MODE=external
# AGE_ASSURANCE_URL=https://provider.example/start
# AGE_ASSURANCE_CALLBACK_SECRET=shared-secret-for-callback-tokens

# Provider credentials: none required for the Pornhub webmaster dump/feeds
# (they are public, unauthenticated endpoints). If a future provider requires
# credentials, add them here — never commit real values.
